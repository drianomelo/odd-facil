# Odd Fácil - Environment Variables
# Copie para .env.local e preencha com suas credenciais

# ============================================
# THE ODDS API (the-odds-api.com)
# Plano gratuito: 500 requests/mês, odds pré-jogo
# Cadastro necessário: Sim
# Restrições: Apenas mercados principais (h2h, spreads, totals)
# ============================================
ODDS_API_KEY=
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4

# PropLine (https://www.prop-line.com/)
# Plano grátis declarado: 1.000 chamadas/dia, sem cartão; linhas de props NBA e logs de jogos.
# Configure uma chave gratuita para habilitar o radar analítico de jogadores.
PROPLINE_API_KEY=

# ============================================
# BANCO DE DADOS (Neon PostgreSQL - Free Tier)
# Plano gratuito: 0.5 GB storage, 100h compute/mês
# Compatível com Vercel Serverless
# ============================================
DATABASE_URL=

# ============================================
# CRON SECRET (para proteger endpoint de atualização automática)
# Gere com: openssl rand -hex 32
# ============================================
CRON_SECRET=

# ============================================
# ADMIN SECRET (para área administrativa manual)
# Gere com: openssl rand -hex 32
# ============================================
ADMIN_SECRET=

# ============================================
# CONFIGURAÇÕES DA APLICAÇÃO
# ============================================
# Fuso horário para exibição (America/Bahia = UTC-3 sem horário de verão)
APP_TIMEZONE=America/Bahia

# Primeiro jogo da temporada regular atual (usado para identificar pré-temporada no histórico)
NBA_REGULAR_SEASON_START=2026-10-20

# Limite de créditos mensais (reserva 20% de margem no plano gratuito de 500)
MONTHLY_CREDIT_LIMIT=400

# Horário da atualização automática diária (formato cron UTC)
# 11:00 UTC = 08:00 America/Bahia (antes dos jogos da noite)
CRON_SCHEDULE="0 11 * * *"

# Número máximo de oportunidades exibidas
MAX_OPPORTUNITIES=5

# Limiares experimentais (ajuste após validação)
MIN_EV_THRESHOLD=0.05
MIN_DATA_COMPLETENESS=0.6
MAX_ODDS_AGE_HOURS=12

# Modo demonstração (usa dados simulados quando APIs indisponíveis)
DEMO_MODE=false

# Fonte da tela inicial: api usa os dados reais; static mantém dados demonstrativos para ajustes visuais.
DASHBOARD_DATA_SOURCE=api

